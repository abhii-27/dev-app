pipeline {

             agent {

                 label {

               label "slave-1"
               customWorkspace "/mnt/dev-app1
           }
        }
     
               stages {

                     stage ('one') {
 
                              steps {

                                       echo "deploying index.html on httpd"

                                                   }
 
                                           }
                      stage ('two') {
 
                              steps {


                                      sh " sudo service start httpd" 


                                                   }
 
                                           }
                        stage ('three') {
 
                              steps {

                                   sh "sudo cp -r index.html /var/www/html/"
                                   sh "sudo chmod -R 777 /var/www/html/index.html"

                                                   }
 
                                           }
                      
                            }

          }
